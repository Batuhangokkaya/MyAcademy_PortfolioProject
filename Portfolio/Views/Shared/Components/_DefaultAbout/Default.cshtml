@model AboutViewModel
@*
    Default About
*@

<!-- About Section -->
<section class="py-section-padding-mobile md:py-section-padding-desktop px-gutter relative bg-surface-container-lowest" id="about">
        <div class="max-w-container-max mx-auto grid grid-cols-1 md:grid-cols-2 gap-stack-lg items-center">
        @foreach (var about in Model.About)
        {
            <div class="relative w-full aspect-square rounded-xl overflow-hidden glass-card">
                <img alt="Professional portrait" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500" data-alt="Professional portrait of a software engineer in a modern workspace" src="@about.ImageURL" />
            </div>
            <div class="flex flex-col gap-stack-md">
                <h2 class="font-headline-md text-headline-md text-on-background">@about.Title</h2>
                <p class="font-body-md text-body-md text-on-surface-variant">@about.Description</p>
                <div class="grid grid-cols-2 gap-stack-md mt-stack-sm">
                        <div>
                            <h4 class="font-label-sm text-label-sm text-primary mb-1">Frontend</h4>
                        @foreach (var frontEnd in Model.Frontends)
                        {
                            <p class="font-body-md text-body-md text-on-surface-variant">@frontEnd.Name</p>
                        }
                        </div>
                    
                   
                        <div>
                            <h4 class="font-label-sm text-label-sm text-primary mb-1">Backend</h4>
                        @foreach (var backEnd in Model.Backends)
                        {
                            <p class="font-body-md text-body-md text-on-surface-variant">@backEnd.Name</p>
                        }
                        </div>
                </div>
            </div>
        }
        </div>
</section>