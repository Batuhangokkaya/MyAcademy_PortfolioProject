@model Testimonial
@*
    Default Testimonial
*@

<!-- Testimonial Comment Section -->
<div class="glass-card p-stack-lg rounded-xl">
    <form class="flex flex-col gap-stack-md" id="CommentForm" method="post" asp-controller="Testimonial" asp-action="AddTestimonial">
        <div>
            <label class="font-label-sm text-label-sm text-on-surface-variant block mb-2">
                Puanınız
            </label>

            <div id="rating-stars" class="flex gap-1 cursor-pointer">
                @for (int i = 1; i <= 5; i++)
                {
                    <span class="material-symbols-outlined star text-primary text-3xl"
                          data-value="@i"
                          style="font-variation-settings:'FILL' 0;">
                        star
                    </span>
                }
            </div>

            <input type="hidden" asp-for="Rating" id="Rating" />
        </div>
        <div>
            <label class="font-label-sm text-label-sm text-on-surface-variant block mb-2" for="name">Adınız</label>
            <input class="w-full bg-surface-variant/50 border border-outline-variant rounded-md px-4 py-3 text-on-background focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="John Doe" type="text" asp-for="FirstName" required />
        </div>
        <div>
            <label class="font-label-sm text-label-sm text-on-surface-variant block mb-2" for="name">Soyadınız</label>
            <input class="w-full bg-surface-variant/50 border border-outline-variant rounded-md px-4 py-3 text-on-background focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="John Doe" type="text" asp-for="LastName" required />
        </div>
        <div>
            <label class="font-label-sm text-label-sm text-on-surface-variant block mb-2" for="name">Mesleğiniz</label>
            <input class="w-full bg-surface-variant/50 border border-outline-variant rounded-md px-4 py-3 text-on-background focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="John Doe" type="text" asp-for="Title" required />
        </div>
        <div>
            <label class="font-label-sm text-label-sm text-on-surface-variant block mb-2" for="email">Yorumunuz</label>
            <textarea class="w-full bg-surface-variant/50 border border-outline-variant rounded-md px-4 py-3 text-on-background focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all min-h-[150px]" placeholder="Mesaj içeriğinizi bu kısma yazın..." asp-for="Comment" required></textarea>
        </div>
        <button class="w-full px-8 py-4 bg-primary text-on-primary rounded-DEFAULT font-label-sm text-label-sm hover:opacity-90 transition-opacity mt-2" type="submit" onclick="SendComment()">Gönder</button>
    </form>
</div>