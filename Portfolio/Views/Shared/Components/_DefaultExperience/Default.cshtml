@model List<Experience>
@*
    Default Experience
*@

<!-- Experience -->
<div class="max-w-5xl mx-auto">
    <h3 class="font-body-lg text-body-lg font-semibold text-on-background mb-8 flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">work</span>
        Deneyimlerim
    </h3>
    <div class="relative border-l border-outline-variant/30 pl-8 space-y-12">
        @foreach (var experience in Model)
        {
            <div class="relative">

                <span class="absolute -left-[38px] top-1 w-4 h-4 rounded-full bg-primary ring-4 ring-background"></span>

                <h4 class="font-semibold text-xl text-on-background">
                    @experience.Title
                </h4>

                <p class="text-primary font-medium mb-3">
                    @experience.StartYear | @experience.EndYear
                </p>

                <p class="text-on-surface-variant leading-7">
                    @experience.Description
                </p>

            </div>
        }
    </div>
</div>