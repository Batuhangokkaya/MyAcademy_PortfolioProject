@model List<Project>
@*
    Default Project
*@

<!-- Project -->
@foreach (var project in Model)
{
    <div class="project-card shrink-0 w-[300px] md:w-[400px] lg:w-[500px] glass-card rounded-xl overflow-hidden group">
        <div class="aspect-video overflow-hidden relative">
            <img alt="Project 1" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@project.ImageURL" />
            <div class="absolute inset-0 bg-background/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <a class="view-project px-6 py-2 bg-primary text-on-primary rounded-DEFAULT font-label-sm text-label-sm transition-all duration-300 hover:bg-primary/80 hover:scale-105 hover:shadow-lg" href="javascript:void(0)" data-name="@project.Name" data-description="@project.Description" data-image="@project.ImageURL" data-github="@project.GithubURL">
                    Projeyi Görüntüle
                </a>
            </div>
        </div>
        <div class="p-stack-md">
            <h3 class="font-body-lg text-body-lg font-semibold text-on-background mb-2">@project.Name</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mb-4 line-clamp-2">@project.Description</p>
            <div class="flex flex-wrap gap-2">

                @foreach (var tech in project.ProjectTechStacks)
                {
                    <span class="px-3 py-1 bg-surface-variant rounded-full font-label-sm text-label-sm text-on-surface">@tech.TechStack.Name</span>
                }
            </div>
        </div>
    </div>
}