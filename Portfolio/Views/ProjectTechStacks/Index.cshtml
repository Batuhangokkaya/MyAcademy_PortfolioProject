@model List<ProjectTechStackViewModel>
@{
    ViewData["Title"] = "Proje Teknolojileri";
    Layout            = "~/Views/AdminLayout/Layout.cshtml";

    int count = 0;
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Proje Adı</th>
            <th>Kullanılan Teknolojiler</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var projectTechStack in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td>@projectTechStack.ProjectName</td>
                <td>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var technology in projectTechStack.TechStack)
                        {
                            <span class="inline-flex items-center gap-2 rounded-full bg-blue-100 px-3 py-1 text-sm font-medium text-blue-700">
                                @technology.Name
                                <form asp-controller="ProjectTechStacks" asp-action="Delete" asp-route-id="@technology.Id" method="post" class="inline">

                                    <button type="submit" class="flex items-center justify-center text-blue-600 hover:text-red-600 transition-colors border-0 bg-transparent p-0">
                                        <span class="material-symbols-outlined text-[16px]">close</span>
                                    </button>
                                </form>
                            </span>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<a class="btn btn-outline-dark" href="/ProjectTechStacks/Create">Yeni Giriş</a>