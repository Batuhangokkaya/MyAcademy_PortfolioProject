@model Skill
@{
    ViewData["Title"] = "Yetenek Ekle";
    Layout            = "~/Views/AdminLayout/Layout.cshtml";
}

<header class="mb-10 flex flex-col">
    <div>
        <h2 class="text-display-lg text-on-surface">
            Yetenek Ekle
        </h2>
        <p class="text-body-lg text-on-surface-variant">
            Yeteneğinizi buradan ekleyebilirsiniz.
        </p>
    </div>
</header>
<div class="px-container-padding py-stack-md max-w-5xl mx-auto">
    <form asp-controller="Skill" asp-action="Create" method="post" class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
        <div class="p-8 space-y-8">
            <div class="space-y-2">
                <label class="block font-label-caps text-label-caps text-on-surface-variant uppercase">Yetenek</label>
                <input type="text" asp-for="Name" class="w-full bg-surface-container-low border border-outline rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none" placeholder="Yetenek adını giriniz" />
                <span asp-validation-for="Name" class="text-sm text-red-600"></span>
            </div>
            <div class="space-y-2">
                <label class="block font-label-caps text-label-caps text-on-surface-variant uppercase">Değer</label>
                <input type="number" min="1" max="100" asp-for="Value" class="w-full bg-surface-container-low border border-outline rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none resize-none" placeholder="Yetenek değeri giriniz"></input>
                <span asp-validation-for="Value" class="text-sm text-red-600"></span>
            </div>
            <!-- GitHub URL -->
            <div class="space-y-2">
                <label class="block font-label-caps text-label-caps text-on-surface-variant uppercase">Seviye</label>
                <div class="relative">
                    <input asp-for="Level" type="text" placeholder="Seviye giriniz" class="w-full bg-surface-container-low border border-outline rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none resize-none" />
                </div>
                <span asp-validation-for="Level" class="text-sm text-red-600"></span>
            </div>
            <div class="flex flex-col md:flex-row justify-end items-center gap-4 pt-2">
                <a href="/Skill/Index" class="w-full md:w-auto px-8 py-2.5 rounded-full border border-outline text-on-surface-variant font-title-sm text-center hover:bg-surface-container-high transition-colors">
                    İptal
                </a>
                <button type="submit" class="w-full md:w-auto px-12 py-2.5 rounded-full bg-primary text-on-primary font-title-sm hover:shadow-lg active:scale-95 transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                    Ekle
                </button>
            </div>
        </div>
    </form>
</div>