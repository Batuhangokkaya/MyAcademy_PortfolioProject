@model ProjectUpdateViewModel

@{
    ViewData["Title"] = "Proje Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<header class="mb-10 flex flex-col">
    <div>
        <h2 class="text-display-lg text-on-surface">Proje Ekle</h2>
        <p class="text-body-lg text-on-surface-variant">Projeyi buradan ekleyebilirsiniz.</p>
    </div>
</header>

<div class="mx-auto max-w-5xl px-3 py-4 md:px-4 md:py-5 xl:px-6 xl:py-6">
    <form asp-controller="Project" asp-action="CreateProject" method="post" class="overflow-hidden rounded-xl border border-outline-variant bg-surface-container-lowest shadow-sm">
        <div class="space-y-8 p-8">

            <div class="space-y-2">
                <label asp-for="Name" class="block font-label-caps text-label-caps uppercase text-on-surface-variant">Proje Adı</label>
                <input asp-for="Name" type="text" class="w-full rounded-lg border border-outline bg-surface-container-low px-4 py-3 outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20" placeholder="Proje adını giriniz" />
                <span asp-validation-for="Name" class="text-sm text-red-600"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="ImageURL" class="block font-label-caps text-label-caps uppercase text-on-surface-variant">Görsel URL</label>

                <div class="relative">
                    <span class="material-symbols-outlined pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[20px] text-on-surface-variant">image</span>
                    <input asp-for="ImageURL" type="text" class="w-full rounded-lg border border-outline bg-surface-container-low py-3 pl-12 pr-4 outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20" placeholder="https://example.com/image.jpg" />
                </div>

                <span asp-validation-for="ImageURL" class="text-sm text-red-600"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="Description" class="block font-label-caps text-label-caps uppercase text-on-surface-variant">Açıklama</label>
                <textarea asp-for="Description" rows="6" class="w-full resize-none rounded-lg border border-outline bg-surface-container-low px-4 py-3 outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20" placeholder="Proje detaylarını buraya yazınız..."></textarea>
                <span asp-validation-for="Description" class="text-sm text-red-600"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="GithubURL" class="block font-label-caps text-label-caps uppercase text-on-surface-variant">GitHub URL</label>

                <div class="relative">
                    <span class="material-symbols-outlined pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-[20px] text-on-surface-variant">code</span>
                    <input asp-for="GithubURL" type="url" class="w-full rounded-lg border border-outline bg-surface-container-low py-3 pl-12 pr-4 outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20" placeholder="https://github.com/kullanici/proje" />
                </div>

                <span asp-validation-for="GithubURL" class="text-sm text-red-600"></span>
            </div>

            <div class="space-y-3">
                <label class="block font-label-caps text-label-caps uppercase text-on-surface-variant">Kullanılan Teknolojiler</label>

                <div class="w-full rounded-lg border border-outline bg-surface-container-low p-4">
                    <div class="flex flex-wrap gap-2">

                        @if (Model.TechStacks != null && Model.TechStacks.Any())
                        {
                            foreach (var tech in Model.TechStacks)
                            {
                                var techId = Convert.ToInt32(tech.Value);
                                var isSelected = Model.SelectedTechStackIds != null && Model.SelectedTechStackIds.Contains(techId);

                                <label class="cursor-pointer">
                                    <input type="checkbox" name="SelectedTechStackIds" value="@tech.Value" class="peer sr-only" checked="@isSelected" />

                                    <span class="inline-flex items-center gap-2 rounded-full border border-outline-variant bg-surface-container-lowest px-4 py-2 text-on-surface-variant transition-all hover:border-primary peer-checked:border-primary peer-checked:bg-primary peer-checked:text-on-primary">
                                        <span class="material-symbols-outlined text-[18px]">check</span>
                                        <span class="text-label-sm">@tech.Text</span>
                                    </span>
                                </label>
                            }
                        }
                        else
                        {
                            <p class="text-sm text-on-surface-variant">Henüz teknoloji eklenmemiş.</p>
                        }

                    </div>
                </div>

                <span asp-validation-for="SelectedTechStackIds" class="text-sm text-red-600"></span>
            </div>

            <div class="flex flex-col items-center justify-end gap-4 pt-2 md:flex-row">
                <a asp-controller="Project" asp-action="Index" class="w-full rounded-full border border-outline px-8 py-2.5 text-center font-title-sm text-on-surface-variant transition-colors hover:bg-surface-container-high md:w-auto">İptal</a>

                <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-full bg-primary px-12 py-2.5 font-title-sm text-on-primary transition-all hover:shadow-lg active:scale-95 md:w-auto">
                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                    Ekle
                </button>
            </div>

        </div>
    </form>
</div>