@model List<Service>
@{
    ViewData["Title"] = "Hizmetlerim";
    Layout           = "~/Views/AdminLayout/Layout.cshtml";
}

<header class="mb-10 flex flex-col">
    <div>
        <h2 class="text-display-lg text-on-surface">
            Hizmetlerim
        </h2>
        <p class="text-body-lg text-on-surface-variant">
            Portfolyonuzda sunduğunuz hizmetleri yönetin..
        </p>
    </div>
    <div class="flex flex-col md:flex-row md:items-center justify-end gap-4 mb-stack-lg mb-1">
        <a href="/Service/Create" class="bg-primary hover:bg-primary-container text-on-primary px-6 py-2.5 rounded-lg font-title-md flex items-center gap-2 transition-all shadow-sm active:scale-95" onclick="document.getElementById('skillModal').classList.remove('hidden')">
            <span class="material-symbols-outlined">add</span>
            Yeni Hizmet Ekle
        </a>
    </div>
</header>
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-gutter">
    @foreach (var service in Model)
    {
        <div class="group relative bg-surface-container-lowest border border-outline-variant rounded-xl p-6 transition-all duration-300 hover:border-primary hover:shadow-lg service-card">
            <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-primary-fixed flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-3xl">@service.IconURL</span>
                </div>
            </div>
            <h3 class="font-title-lg text-title-lg text-on-surface mb-2">@service.Title</h3>
            <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2">@service.Description</p>
            <div class="mt-6 flex items-center justify-end gap-2 service-actions">
                <a href="/Service/Update/@service.ID" class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container-high rounded-lg transition-all">
                    <span class="material-symbols-outlined">edit</span>
                </a>
                <a href="/Service/Delete/@service.ID" class="p-2 text-on-surface-variant hover:text-error hover:bg-error-container/20 rounded-lg transition-all">
                    <span class="material-symbols-outlined">delete</span>
                </a>
            </div>
        </div>
    }
    <!-- Add New Placeholder Card -->
    <a href="/Service/Create">
        <div class="cursor-pointer group flex flex-col items-center justify-center bg-surface border-2 border-dashed border-outline-variant rounded-xl p-6 transition-all duration-300 hover:border-primary hover:bg-surface-container-low min-h-[220px]" onclick="openModal()">
            <div class="w-14 h-14 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant group-hover:bg-primary-fixed group-hover:text-primary transition-all">
                <span class="material-symbols-outlined text-3xl">add_circle</span>
            </div>
            <p class="font-title-md text-title-md text-on-surface-variant mt-4 group-hover:text-primary transition-all">Yeni Hizmet Ekle</p>
        </div>
    </a>
</div>