@model TechStack
@{
    ViewData["Title"] = "Teknoloji Güncelle";
    Layout            = "~/Views/AdminLayout/Layout.cshtml";
}

<header class="mb-10 flex flex-col">
    <div>
        <h2 class="text-display-lg text-on-surface">
            Teknoloji Güncelle
        </h2>
        <p class="text-body-lg text-on-surface-variant">
            Teknolojinizi buradan güncelleyebilirsiniz.
        </p>
    </div>
</header>
<div class="px-container-padding py-stack-md max-w-5xl mx-auto">
    <form asp-controller="TechStack" asp-action="Update" method="post" class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
        <input type="hidden" asp-for="ID" />
        <div class="p-8 space-y-8">
            <div class="space-y-2">
                <label class="block font-label-caps text-label-caps text-on-surface-variant uppercase">Teknoloji Adı</label>
                <input type="text" asp-for="Name" class="w-full bg-surface-container-low border border-outline rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none" placeholder="Teknoloji adını giriniz" />
                <span asp-validation-for="Name" class="text-sm text-red-600"></span>
            </div>
            <div class="space-y-2">
                <label class="block font-label-caps text-label-caps text-on-surface-variant uppercase">Kategori Adı</label>
                <select asp-for="CategoryID" asp-items="@ViewBag.CategoryList" class="w-full bg-surface-container-low border border-outline rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none">
                    <option selected="selected" disabled>Kategori Seçiniz</option>
                </select>
                <span asp-validation-for="CategoryID" class="text-sm text-red-600"></span>
            </div>
            <div class="flex flex-col md:flex-row justify-end items-center gap-4 pt-2">
                <a href="/TechStack/Index" class="w-full md:w-auto px-8 py-2.5 rounded-full border border-outline text-on-surface-variant font-title-sm text-center hover:bg-surface-container-high transition-colors">
                    İptal
                </a>
                <button type="submit" class="w-full md:w-auto px-12 py-2.5 rounded-full bg-primary text-on-primary font-title-sm hover:shadow-lg active:scale-95 transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                    Güncelle
                </button>
            </div>
        </div>
    </form>
</div>