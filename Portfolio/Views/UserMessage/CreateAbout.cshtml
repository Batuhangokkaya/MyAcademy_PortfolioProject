@model About
@{
    ViewData["Title"] = "Yeni Hakkımda Bilgisi Ekle";
    Layout            = "~/Views/AdminLayout/Layout.cshtml";
}

<header class="mb-10 flex flex-col">
    <div>
        <h2 class="text-display-lg text-on-surface">
            Hakkımda Ekle
        </h2>

        <p class="text-body-lg text-on-surface-variant">
            Hakkımda buradan ekleyebilirsiniz.
        </p>
    </div>
</header>
<div class="px-container-padding py-stack-md max-w-5xl mx-auto">
    <form asp-controller="About" asp-action="CreateAbout" method="post" class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
        <div class="p-8 space-y-8">
            <div class="space-y-2">
                <label class="block font-label-caps text-label-caps text-on-surface-variant uppercase">Başlık</label>
                <input type="text" asp-for="Title" class="w-full bg-surface-container-low border border-outline rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none" placeholder="Başlık giriniz" />
                <span asp-validation-for="Title" class="text-sm text-red-600"></span>
            </div>
            <div class="space-y-2">
                <label class="block font-label-caps text-label-caps text-on-surface-variant uppercase">Görsel URL</label>
                <div class="relative">
                    <span class="material-symbols-outlined pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">image</span>
                    <input asp-for="ImageURL" type="text" placeholder="https://example.com/image.jpg" class="w-full bg-surface-container-low border border-outline rounded-lg py-3 pl-12 pr-4 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none" />
                    <span asp-validation-for="ImageURL" class="text-sm text-red-600"></span>
                </div>
            </div>
            <div class="space-y-2">
                <label class="block font-label-caps text-label-caps text-on-surface-variant uppercase">Açıklama</label>
                <textarea asp-for="Description" rows="6" class="w-full bg-surface-container-low border border-outline rounded-lg px-4 py-3 focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all outline-none resize-none" placeholder="Hakkımda detaylarını buraya yazınız..."></textarea>
                <span asp-validation-for="Description" class="text-sm text-red-600"></span>
            </div>
            <div class="flex flex-col md:flex-row justify-end items-center gap-4 pt-2">
                <a href="/About/Index" class="w-full md:w-auto px-8 py-2.5 rounded-full border border-outline text-on-surface-variant font-title-sm text-center hover:bg-surface-container-high transition-colors">
                    İptal
                </a>
                <button type="submit" class="w-full md:w-auto px-12 py-2.5 rounded-full bg-primary text-on-primary font-title-sm hover:shadow-lg active:scale-95 transition-all flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">check_circle</span>
                    Ekle
                </button>
            </div>
        </div>
    </form>
</div>