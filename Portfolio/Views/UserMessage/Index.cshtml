@model List<UserMessage>
@{
    ViewData["Title"] = "Mesajlarım";
    Layout            = "~/Views/AdminLayout/Layout.cshtml";
}

<header class="mb-10 flex flex-col">
    <div>
        <h2 class="text-display-lg text-on-surface">
            Mesaj
        </h2>

        <p class="text-body-lg text-on-surface-variant">
            Mesaj alanını buradan yönetebilirsiniz
        </p>
    </div>
</header>
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low border-b border-outline-variant">
                    <th class="px-6 py-4 font-label-lg text-label-lg text-on-surface-variant font-semibold">Gönderen</th>
                    <th class="px-6 py-4 font-label-lg text-label-lg text-on-surface-variant font-semibold">Email</th>
                    <th class="px-6 py-4 font-label-lg text-label-lg text-on-surface-variant font-semibold">Konu</th>
                    <th class="px-6 py-4 font-label-lg text-label-lg text-on-surface-variant font-semibold">Tarih</th>
                    <th class="px-6 py-4 font-label-lg text-label-lg text-on-surface-variant font-semibold">Durum</th>
                    <th class="px-6 py-4 font-label-lg text-label-lg text-on-surface-variant font-semibold text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
                @foreach (var userMessage in Model)
                {
                    <tr class="group hover:bg-surface-container transition-colors cursor-pointer" onclick="openMessage('@userMessage.Name', '@userMessage.Email', 'İş Teklifi', '@userMessage.MessageBody', '@userMessage.Date.ToShortDateString()')">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-full bg-secondary-fixed flex items-center justify-center font-bold text-on-secondary-fixed text-sm">@userMessage.Initials</div>
                                <span class="font-label-lg text-label-lg text-on-surface message-unread">@userMessage.Name</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 font-body-md text-body-md text-on-surface-variant">@userMessage.Email</td>
                        <td class="px-6 py-4">
                            <div class="flex flex-col">
                                <span class="font-label-lg text-label-lg text-on-surface message-unread">İş Teklifi</span>
                                <span class="font-body-md text-body-md text-on-surface-variant truncate max-w-[200px]">@(userMessage.MessageBody.Length >= 40 ? userMessage.MessageBody.Substring(0, 40) : userMessage.MessageBody)</span>
                            </div>
                        </td>
                        <td class="px-6 py-4 font-body-md text-body-md text-on-surface-variant whitespace-nowrap">@userMessage.Date.ToShortDateString()</td>
                        <td class="px-6 py-4">
                            <a href="/UserMessage/IsStatus/@userMessage.ID" class="px-3 py-1 bg-primary/10 text-primary rounded-full text-label-sm font-label-sm font-bold border border-primary/20">@(userMessage.IsRead ? "Okundu" : "Okunmadı")</a>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a href="/UserMessage/Delete/@userMessage.ID" type="button" class="p-2 hover:bg-error-container rounded-lg text-error transition-colors" title="Sil">
                                    <span class="material-symbols-outlined">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="px-6 py-4 border-t border-outline-variant flex items-center justify-between">
        <span class="font-body-md text-body-md text-on-surface-variant">Toplam Mesaj: @ViewBag.UserMessageCount</span>
    </div>
</div>
<div class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 hidden transition-opacity duration-300 opacity-0" id="drawerOverlay" onclick="closeDrawer()"></div>
<div class="fixed right-0 top-0 h-full w-full max-w-md bg-surface-container-lowest z-[60] transform translate-x-full drawer-transition shadow-2xl flex flex-col" id="messageDrawer">
    <div class="p-6 border-b border-outline-variant flex items-center justify-between">
        <h4 class="font-title-lg text-title-lg text-on-surface">Mesaj Detayı</h4>
        <button class="p-2 hover:bg-surface-container-high rounded-full transition-colors text-outline" onclick="closeDrawer()">
            <span class="material-symbols-outlined">close</span>
        </button>
    </div>
    <div class="flex-grow overflow-y-auto p-6">
        <div class="mb-8">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-14 h-14 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold text-lg" id="drawerInitials">AY</div>
                <div>
                    <h5 class="font-title-md text-title-md text-on-surface" id="drawerName">Ahmet Yılmaz</h5>
                    <p class="font-body-md text-body-md text-on-surface-variant" id="drawerEmail">ahmet.y@example.com</p>
                </div>
            </div>
            <div class="space-y-6">
                <div>
                    <label class="block text-label-sm font-label-sm text-outline mb-1 uppercase tracking-wider">Konu</label>
                    <p class="font-title-md text-title-md text-on-surface font-semibold" id="drawerSubject">İş Teklifi</p>
                </div>
                <div>
                    <label class="block text-label-sm font-label-sm text-outline mb-1 uppercase tracking-wider">Tarih</label>
                    <p class="font-body-md text-body-md text-on-surface-variant" id="drawerDate">Bugün, 14:20</p>
                </div>
                <div class="bg-surface-container-low p-4 rounded-xl border border-outline-variant/50">
                    <label class="block text-label-sm font-label-sm text-outline mb-2 uppercase tracking-wider">Mesaj</label>
                    <p class="font-body-lg text-body-lg text-on-surface leading-relaxed" id="drawerContent">
                        Merhaba Batuhan, portfolio projelerini çok beğendim. Bir React projesi için freelance destek almayı düşünüyoruz. Görüşebilir miyiz?
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div class="p-6 border-t border-outline-variant bg-surface-container-lowest">
        <div class="flex gap-3">
            <button class="flex-grow bg-primary text-on-primary px-6 py-3 rounded-lg font-label-lg text-label-lg font-bold hover:bg-surface-tint transition-all shadow-md flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-[20px]">reply</span>
                Yanıtla
            </button>
            <button class="p-3 border border-outline-variant rounded-lg hover:bg-error-container hover:text-error transition-all group">
                <span class="material-symbols-outlined">delete</span>
            </button>
        </div>
    </div>
</div>

<script>
    function openMessage(name, email, subject, content, date) {
        const drawer = document.getElementById('messageDrawer');
        const overlay = document.getElementById('drawerOverlay');

        // Populate content
        document.getElementById('drawerName').innerText = name;
        document.getElementById('drawerEmail').innerText = email;
        document.getElementById('drawerSubject').innerText = subject;
        document.getElementById('drawerContent').innerText = content;
        document.getElementById('drawerDate').innerText = date;

        // Initials logic
        const initials = name.split(' ').map(n => n[0]).join('').toUpperCase();
        document.getElementById('drawerInitials').innerText = initials;

        // Show drawer
        overlay.classList.remove('hidden');
        setTimeout(() => {
            overlay.classList.add('opacity-100');
            drawer.classList.remove('translate-x-full');
        }, 10);
    }

    function closeDrawer() {
        const drawer = document.getElementById('messageDrawer');
        const overlay = document.getElementById('drawerOverlay');

        drawer.classList.add('translate-x-full');
        overlay.classList.remove('opacity-100');

        setTimeout(() => {
            overlay.classList.add('hidden');
        }, 300);
    }

    function markAllAsRead() {
        // Simplified micro-interaction for marking read
        const rows = document.querySelectorAll('tr.group');
        rows.forEach(row => {
            const badge = row.querySelector('.bg-primary\\/10');
            const textBold = row.querySelectorAll('.message-unread');

            if (badge) {
                badge.className = 'px-3 py-1 bg-surface-container-high text-on-surface-variant rounded-full text-label-sm font-label-sm border border-outline-variant';
                badge.innerText = 'Okundu';
            }

            textBold.forEach(el => {
                el.classList.remove('message-unread');
                el.classList.remove('font-bold');
            });
        });

        // Update summary
        const unreadCount = document.querySelector('.bg-error-container + h3 + p');
        if (unreadCount) unreadCount.innerText = "0";

        alert('Tüm mesajlar okundu olarak işaretlendi.');
    }

    // Search highlight micro-interaction
    const searchInput = document.querySelector('input[type="text"]');
    searchInput.addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase();
        const rows = document.querySelectorAll('tbody tr');

        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            if (text.includes(term)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });
 </script>