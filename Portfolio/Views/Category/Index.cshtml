@model List<Category>
@{
    ViewData["Title"] = "Kategorilerim";
    Layout            = "~/Views/AdminLayout/Layout.cshtml";

    int count = 0;
}

<!-- Header Section -->
<header class="mb-10 flex flex-col">
    <div>
        <h2 class="text-display-lg text-on-surface">
            Kategorilerim
        </h2>

        <p class="text-body-lg text-on-surface-variant">
            Portfolyonuzdaki projeleri buradan yönetebilirsiniz
        </p>
    </div>

    <a href="/Category/Create" class="self-end mt-1 inline-flex items-center justify-center gap-2 px-6 py-2.5 bg-primary text-on-primary rounded-lg whitespace-nowrap hover:shadow-lg transition-all active:scale-95">
        <span class="material-symbols-outlined">add</span>
        <span>Yeni Kategori Ekle</span>
    </a>
</header>
<!-- Filters & Table Section -->
<div class="bg-surface-container-lowest rounded-xl border border-outline-variant overflow-hidden">
    <div class="overflow-x-auto custom-scrollbar">
        <table class="w-full min-w-[1100px] table-fixed text-left border-collapse">
            <thead class="bg-surface-container-low border-b border-outline-variant">
                <tr>
                    <th class="w-[20%] p-gutter font-label-lg text-on-surface-variant uppercase tracking-wider">#</th>
                    <th class="w-[20%] p-gutter font-label-lg text-on-surface-variant uppercase tracking-wider">Kategori Adı</th>
                    <th class="w-[30%] p-gutter font-label-lg text-on-surface-variant uppercase tracking-wider">Proje Sayısı</th>
                    <th class="w-[14%] p-gutter font-label-lg text-on-surface-variant uppercase tracking-wider text-right">İşlemler</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant">
                @foreach (var category in Model)
                {
                    count++;
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <td class="p-gutter align-middle font-title-md text-on-surface">
                            @count
                        </td>
                        <td class="p-gutter align-middle font-title-md text-on-surface">
                            @category.Name
                        </td>
                        <td class="p-gutter align-middle font-title-md text-on-surface">
                            @if (category.Name == "Frontend")
                            {
                                <span>@ViewBag.FrontendProjectCount</span>
                            }
                            else if (category.Name == "Backend")
                            {
                                <span>@ViewBag.BackendProjectCount</span>
                            }
                            else
                            {
                                <span>0</span>
                            }
                        </td>
                        <td class="p-gutter align-middle">
                            <div class="flex items-center justify-end gap-2">
                                <a href="/Category/Update/@category.ID" type="button" class="p-2 hover:bg-primary-fixed rounded-lg text-primary transition-colors" title="Düzenle">
                                    <span class="material-symbols-outlined">edit</span>
                                </a>
                                <a href="/Category/Delete/@category.ID" type="button" class="p-2 hover:bg-error-container rounded-lg text-error transition-colors" title="Sil">
                                    <span class="material-symbols-outlined">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="p-gutter flex items-center justify-between bg-surface-container-low border-t border-outline-variant">
        <p class="font-label-sm text-on-surface-variant">
            Toplam Kategori: @ViewBag.CategoryCount
        </p>
    </div>
</div>