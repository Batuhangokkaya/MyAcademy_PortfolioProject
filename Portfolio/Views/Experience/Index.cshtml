@model List<Experience>
@{
    ViewData["Title"] = "Deneyimlerim";
    Layout           = "~/Views/AdminLayout/Layout.cshtml";
}

<header class="mb-10 flex flex-col">
    <div>
        <h2 class="text-display-lg text-on-surface">
            Deneyimlerim
        </h2>
        <p class="text-body-lg text-on-surface-variant">
            İş ve staj deneyimlerinizi yönetin.
        </p>
    </div>

    <div class="flex flex-col md:flex-row md:items-center justify-end gap-4 mb-stack-lg mb-1">
        <a href="/Experience/Create" class="bg-primary hover:bg-primary-container text-on-primary px-6 py-2.5 rounded-lg font-title-md flex items-center gap-2 transition-all shadow-sm active:scale-95" onclick="document.getElementById('skillModal').classList.remove('hidden')">
            <span class="material-symbols-outlined">add</span>
            Yeni Deneyim Ekle
        </a>
    </div>
</header>
<div class="pt-[1px] px-container-padding pb-container-padding">
    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant overflow-hidden">
        <div class="p-6">
            <div class="space-y-0 relative timeline-line">
                @foreach (var experience in Model)
                {
                    <div class="relative pl-12 pb-12">
                        <!-- Timeline Dot -->
                        <div class="absolute left-0 top-1 w-10 h-10 flex items-center justify-center">
                            <div class="w-4 h-4 bg-outline-variant rounded-full timeline-dot"></div>
                        </div>
                        <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 p-5 rounded-xl border border-outline-variant hover:bg-surface-container-low transition-colors duration-300">
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <h3 class="font-title-lg text-title-lg text-on-surface">@experience.Title</h3>
                                </div>
                                <div class="flex flex-wrap items-center gap-y-2 gap-x-6 text-on-surface-variant mb-4">
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-[18px]">business</span>
                                        <span class="font-body-md text-body-md font-medium">@experience.Company</span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-[18px]">calendar_today</span>
                                        <span class="font-body-md text-body-md">@experience.StartYear - @experience.EndYear</span>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <span class="material-symbols-outlined text-[18px]">location_on</span>
                                        <span class="font-body-md text-body-md">İstanbul, TR</span>
                                    </div>
                                </div>
                                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed max-w-3xl">
                                    @experience.Description
                                </p>
                            </div>
                            <div class="flex flex-row md:flex-col gap-2 shrink-0">
                                <a href="/Experience/Update/@experience.ID" class="p-2 text-on-surface-variant hover:bg-surface-container-high rounded-lg transition-colors">
                                    <span class="material-symbols-outlined">edit</span>
                                </a>
                                <a href="/Experience/Delete/@experience.ID" class="p-2 text-error hover:bg-error-container/20 rounded-lg transition-colors">
                                    <span class="material-symbols-outlined">delete</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>