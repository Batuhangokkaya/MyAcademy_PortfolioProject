@model LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html class="dark" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>ALEX.DEV | Giriş Yap</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=Hanken+Grotesk:wght@700;800&amp;family=Geist:wght@400;500&amp;display=swap" rel="stylesheet" />
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "tertiary-container": "#d4b955",
                      "outline-variant": "#464650",
                      "surface-dim": "#131313",
                      "tertiary-fixed-dim": "#e1c560",
                      "outline": "#918f9b",
                      "surface-variant": "#353534",
                      "on-background": "#e5e2e1",
                      "surface-bright": "#3a3939",
                      "surface-container-highest": "#353534",
                      "on-error": "#690005",
                      "on-primary-fixed-variant": "#3f3f81",
                      "background": "#131313",
                      "error": "#ffb4ab",
                      "on-primary": "#282869",
                      "secondary-container": "#474746",
                      "inverse-on-surface": "#313030",
                      "on-primary-fixed": "#120f54",
                      "inverse-surface": "#e5e2e1",
                      "on-secondary": "#313030",
                      "surface-container-lowest": "#0e0e0e",
                      "secondary": "#c8c6c5",
                      "on-secondary-fixed": "#1c1b1b",
                      "on-surface": "#e5e2e1",
                      "on-primary-container": "#434386",
                      "surface-container-high": "#2a2a2a",
                      "error-container": "#93000a",
                      "secondary-fixed": "#e5e2e1",
                      "on-tertiary-container": "#594900",
                      "surface-container": "#201f1f",
                      "primary-container": "#b4b4ff",
                      "on-error-container": "#ffdad6",
                      "surface-container-low": "#1c1b1b",
                      "on-tertiary": "#3b2f00",
                      "secondary-fixed-dim": "#c8c6c5",
                      "on-tertiary-fixed": "#221b00",
                      "surface": "#131313",
                      "on-secondary-container": "#b7b5b4",
                      "tertiary-fixed": "#fee178",
                      "tertiary": "#f1d56d",
                      "surface-tint": "#c1c1ff",
                      "primary-fixed": "#e2dfff",
                      "primary-fixed-dim": "#c1c1ff",
                      "on-tertiary-fixed-variant": "#554500",
                      "on-secondary-fixed-variant": "#474746",
                      "primary": "#d4d3ff",
                      "on-surface-variant": "#c8c5d2",
                      "inverse-primary": "#57579b"
              },
              "borderRadius": {
                      "DEFAULT": "0.125rem",
                      "lg": "0.25rem",
                      "xl": "0.5rem",
                      "full": "0.75rem"
              },
              "spacing": {
                      "container-max": "1280px",
                      "stack-sm": "8px",
                      "unit": "4px",
                      "stack-md": "24px",
                      "margin-desktop": "64px",
                      "stack-lg": "48px",
                      "margin-mobile": "20px",
                      "gutter": "24px"
              },
              "fontFamily": {
                      "body-md": ["Inter"],
                      "label-sm": ["Geist"],
                      "display-lg": ["Hanken Grotesk"],
                      "headline-md": ["Hanken Grotesk"],
                      "code-md": ["Geist"],
                      "body-lg": ["Inter"],
                      "display-lg-mobile": ["Hanken Grotesk"]
              },
              "fontSize": {
                      "body-md": ["16px", {"lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400"}],
                      "label-sm": ["14px", {"lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "500"}],
                      "display-lg": ["72px", {"lineHeight": "1.1", "letterSpacing": "-0.04em", "fontWeight": "800"}],
                      "headline-md": ["32px", {"lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700"}],
                      "code-md": ["14px", {"lineHeight": "1.5", "fontWeight": "400"}],
                      "body-lg": ["18px", {"lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400"}],
                      "display-lg-mobile": ["48px", {"lineHeight": "1.1", "letterSpacing": "-0.04em", "fontWeight": "800"}]
              }
            },
          },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        body {
            background-color: #131313;
            color: #e5e2e1;
        }
        /* Glassmorphism utility */
        .glass-panel {
            background: rgba(20, 20, 20, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
    </style>
</head>
<body class="font-body-md text-body-md antialiased overflow-x-hidden min-h-screen flex flex-col">
    <!-- TopNavBar -->
    <!-- Main Content Canvas -->
    <main class="flex-grow flex items-center justify-center pt-24 pb-stack-lg relative">
        <!-- Subtle Ambient Background Effect -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute -top-[10%] -left-[10%] w-[40%] h-[40%] rounded-full bg-primary/5 blur-[120px]"></div>
            <div class="absolute -bottom-[10%] -right-[10%] w-[40%] h-[40%] rounded-full bg-primary/10 blur-[120px]"></div>
        </div>
        <div class="w-full max-w-md px-margin-mobile relative z-10">
            <!-- Login Card -->
            <div class="glass-panel border border-outline-variant/30 p-stack-lg">
                <div class="mb-stack-lg">
                    <h1 class="font-headline-md text-headline-md text-on-surface mb-2">Hoşgeldin</h1>
                    <p class="font-body-md text-outline">Giriş yaparak projelerinize kaldığınız yerden devam edin.</p>
                </div>
                <form class="space-y-stack-md"  method="post">
                    <!-- Email Field -->
                    <div class="space-y-2">
                        <label class="font-code-md text-code-md uppercase tracking-widest text-outline" for="email">Kullanıcı Adı</label>
                        <div class="relative group">
                            <input class="w-full bg-surface-container-lowest border border-outline-variant/30 px-4 py-3 font-body-md text-on-surface focus:outline-none focus:border-primary-container transition-all placeholder:text-outline-variant" id="email" asp-for="UserName" placeholder="Kullanıcı Adı" type="text" />
                            <span class="text-danger" asp-validation-for="UserName"></span>
                        </div>
                    </div>
                    <!-- Password Field -->
                    <div class="space-y-2">
                        <div class="flex justify-between items-center">
                            <label class="font-code-md text-code-md uppercase tracking-widest text-outline" for="password">ŞİFRE</label>
                            <span class="text-danger" asp-validation-for="Password"></span>
                        </div>
                        <div class="relative group">
                            <input class="w-full bg-surface-container-lowest border border-outline-variant/30 px-4 py-3 font-body-md text-on-surface focus:outline-none focus:border-primary-container transition-all placeholder:text-outline-variant" id="password" asp-for="Password" placeholder="••••••••" type="password" />
                        </div>
                    </div>
                    <!-- vALİDATİON -->
                    <div>
                        <span>@Html.ValidationSummary(excludePropertyErrors: true)</span>
                    </div>
                    <!-- Actions -->
                    <div class="pt-stack-sm">
                        <button class="w-full bg-primary-container text-on-primary-container py-4 font-headline-md text-[18px] font-bold transition-all hover:brightness-110 active:scale-[0.98]" type="submit">
                            Giriş Yap
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>
    <!-- Footer -->
    
   
</body>
</html>